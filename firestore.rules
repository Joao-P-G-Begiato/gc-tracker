rules_version = '2';
// Regras do GC Tracker. Cole no console do Firebase: Firestore Database → Regras → Publicar.
// O ID abaixo é o do dono (CrimsonStorm), o único que edita o catálogo.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function eu(uid) { return logado() && request.auth.uid == uid; }
    function dono() { return logado() && request.auth.uid == "ZyKUgaouUScPRQdZvcQ7gEIEANI2"; }

    // catálogo de personagens, cartas, faixas do Vazio e recursos: todos leem, só o dono grava
    match /config/{id} {
      allow read: if logado();
      allow write: if dono();
    }
    // nick, inventário da conta e resumo dos personagens (ranking): todos leem, cada um grava o seu
    match /jogadores/{uid} {
      allow read: if logado();
      allow write: if eu(uid);
    }
    // ficha completa dos personagens: todos podem ver, cada um grava a sua
    match /fichas/{uid} {
      allow read: if logado();
      allow write: if eu(uid);
    }
    // histórico: só o próprio jogador
    match /historico/{uid} {
      allow read, write: if eu(uid);
    }
  }
}
